PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Database: 'sqlite' or 'mysql'
DB_CLIENT=sqlite
DB_SQLITE_PATH=./src/database/hospital.db

# MySQL Settings
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=hospital_management

# Email Settings
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="CareSync Hospital" <noreply@caresync.com>

CLIENT_URL=http://localhost:5173
