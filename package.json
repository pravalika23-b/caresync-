{
  "name": "care-sync-hospital-management-system",
  "version": "1.0.0",
  "description": "Smart Hospital Management System with Online Appointment & Queue Management",
  "scripts": {
    "start": "node server/src/server.js",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "seed": "npm --prefix server run seed",
    "test:api": "npm --prefix server run test:api",
    "build": "npm --prefix client run build",
    "build:client": "npm --prefix client run build",
    "install:all": "npm --prefix server install && npm --prefix client install"
  },
  "keywords": [
    "hospital-management",
    "queue-system",
    "socketio",
    "react",
    "express",
    "nodejs",
    "fullstack"
  ],
  "author": "Pravalika B",
  "license": "MIT"
}
